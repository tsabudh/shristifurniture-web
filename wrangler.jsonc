{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shristifurniture-web",
  "compatibility_date": "2026-10-01",
  // Static site only: every file under public/ is served as-is, no Worker script.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
